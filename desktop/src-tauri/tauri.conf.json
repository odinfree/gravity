{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gravity",
  "version": "0.1.0",
  "identifier": "org.starknet.strkd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:privacy && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gravity",
        "width": 460,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/prover/**/*",
      "resources/privacy/worker.cjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
